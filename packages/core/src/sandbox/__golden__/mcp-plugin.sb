(version 1)
(allow default)
(deny file-read*)
(import "system.sb")
(allow file-read* (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/Library") (subpath "/Applications") (subpath "/private/etc") (subpath "/private/var/select") (subpath "/private/var/db") (subpath "/dev") (subpath "/opt/homebrew"))
(deny file-read* (subpath "/fixture/home/.emperor"))
(allow file-read* (subpath "/fixture/home/.emperor/plugins/cache/kit") (subpath "/fixture/home/.emperor/workspace") (subpath "/fixture/home/.emperor/plugins/data/kit") (subpath "/fixture/home/.emperor/mcp/cache/kit-docs"))
(allow file-read-metadata (literal "/fixture") (literal "/fixture/home") (literal "/fixture/home/.emperor") (literal "/fixture/home/.emperor/mcp") (literal "/fixture/home/.emperor/mcp/cache") (literal "/fixture/home/.emperor/plugins") (literal "/fixture/home/.emperor/plugins/cache") (literal "/fixture/home/.emperor/plugins/data") (literal "/opt") (literal "/private") (literal "/private/var"))
(deny file-write*)
(allow file-write* (literal "/dev/null"))
(deny file-write* (subpath "/fixture/home/.emperor"))
(allow file-write* (subpath "/fixture/home/.emperor/workspace") (subpath "/fixture/home/.emperor/plugins/data/kit") (subpath "/fixture/home/.emperor/mcp/cache/kit-docs"))
(deny file-write* (regex #"/\.git/(modules/.+/)?hooks/[^/]+$"))
(allow file-write* (regex #"/\.git/(modules/.+/)?hooks/[^/]+\.sample$"))
(deny network-outbound (remote unix-socket (path-regex "^/fixture/home/\\.emperor/run/")))
(deny file-read* file-write* (subpath "/fixture/home/.ssh"))
(deny file-read* file-write* (subpath "/fixture/home/.aws"))
(deny file-read* file-write* (subpath "/fixture/home/.config/gcloud"))
(deny file-read* file-write* (literal "/fixture/home/.docker/config.json"))
(deny file-read* file-write* (literal "/fixture/home/.netrc"))
(deny file-read* file-write* (literal "/fixture/home/.codex/auth.json"))
(deny file-read* file-write* (literal "/fixture/home/.claude/.credentials.json"))
(deny file-read* file-write* (literal "/fixture/home/.emperor/delegations/claude-code/config/.credentials.json"))
(deny file-read* file-write* (subpath "/fixture/home/.emperor/computer-use"))
(deny file-read* file-write* (subpath "/fixture/home/.emperor/browser"))
(deny file-read* file-write* (regex "^/fixture/home/\\.emperor/(model_config|mcp_config|settings\\.json|hooks\\.json)"))
(deny file-write* (literal "/fixture/home/.emperor"))
(deny file-write* (literal "/fixture/home"))
(deny file-write* (literal "/fixture"))
(deny file-write* (literal "/fixture/home/.config"))
(deny file-write* (literal "/fixture/home/.docker"))
(deny file-write* (literal "/fixture/home/.codex"))
(deny file-write* (literal "/fixture/home/.claude"))
(deny file-write* (literal "/fixture/home/.emperor/delegations/claude-code/config"))
(deny file-write* (literal "/fixture/home/.emperor/delegations/claude-code"))
(deny file-write* (literal "/fixture/home/.emperor/delegations"))
