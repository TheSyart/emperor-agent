    {
      "id": "mcp-memory",
      "kind": "mcp",
      "name": "Memory",
      "publisher": "Model Context Protocol",
      "description": "基于本地知识图谱的持久记忆：记录实体、关系与观察，在不同对话之间保留。",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/memory",
      "tags": ["记忆", "需要 Node.js"],
      "install": {
        "mcpConfig": {
          "mcpServers": {
            "memory": {
              "command": "npx",
              "args": ["-y", "@modelcontextprotocol/server-memory"]
            }
          }
        }
      }
    },
    {
      "id": "mcp-sequential-thinking",
      "kind": "mcp",
      "name": "Sequential Thinking",
      "publisher": "Model Context Protocol",
      "description": "把复杂问题拆成可修订、可分支的思考步骤，适合规划和需要反复推敲的分析。",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/sequentialthinking",
      "tags": ["推理", "需要 Node.js"],
      "install": {
        "mcpConfig": {
          "mcpServers": {
            "sequential-thinking": {
              "command": "npx",
              "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
            }
          }
        }
      }
    },
    {
      "id": "mcp-time",
      "kind": "mcp",
      "name": "Time",
      "publisher": "Model Context Protocol",
      "description": "查询当前时间，并在不同 IANA 时区之间换算时间。",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/time",
      "tags": ["时间", "需要 uv"],
      "install": {
        "mcpConfig": {
          "mcpServers": {
            "time": {
              "command": "uvx",
              "args": ["mcp-server-time"]
            }
          }
        }
      }
    },
    {
      "id": "deepwiki",
      "kind": "mcp",
      "name": "DeepWiki",
      "publisher": "Cognition",
      "description": "远程 MCP 服务：阅读 GitHub 公开仓库的 DeepWiki 文档，并就代码库直接提问，无需 API 密钥。",
      "homepage": "https://docs.devin.ai/work-with-devin/deepwiki-mcp",
      "tags": ["文档", "远程"],
      "install": {
        "mcpConfig": {
          "mcpServers": {
            "deepwiki": {
              "type": "http",
              "url": "https://mcp.deepwiki.com/mcp"
            }
          }
        }
      }
    }
