{
  "schemaVersion": 1,
  "cascadeOrder": ["styles/surfaces/menus.css", "styles/surfaces/panels.css"],
  "features": {
    "composer": {
      "view": "components/composer/ComposerCard.vue",
      "controller": "components/chat/composerController.ts",
      "layers": [
        {
          "role": "component-scoped",
          "path": "components/composer/ComposerCard.vue",
          "scoped": true
        },
        {
          "role": "palette-and-picker-surface",
          "path": "styles/surfaces/menus.css"
        },
        {
          "role": "narrow-palette-overrides",
          "path": "styles/surfaces/panels.css"
        }
      ]
    },
    "hooks": {
      "view": "components/settings/HooksSection.vue",
      "controller": "components/settings/hooks/hooksController.ts",
      "layers": [
        {
          "role": "component-scoped",
          "path": "components/settings/HooksSection.vue",
          "scoped": true
        },
        {
          "role": "component-scoped",
          "path": "components/settings/hooks/HooksConfigTab.vue",
          "scoped": true
        },
        {
          "role": "component-scoped",
          "path": "components/settings/hooks/HooksTestTab.vue",
          "scoped": true
        },
        {
          "role": "component-scoped",
          "path": "components/settings/hooks/HooksAuditTab.vue",
          "scoped": true
        }
      ]
    }
  }
}
