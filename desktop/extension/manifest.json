{
  "manifest_version": 3,
  "name": "Emperor Agent Browser Connector",
  "description": "Connect a tab you choose to Emperor Agent.",
  "version": "0.3.0",
  "minimum_chrome_version": "105",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "storage",
    "tabGroups",
    "downloads",
    "history"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Emperor Agent",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "key": ""
}
