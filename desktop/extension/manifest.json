{
  "manifest_version": 3,
  "name": "Emperor Agent Browser Connector",
  "description": "Connect a tab you choose to Emperor Agent.",
  "version": "0.1.0",
  "minimum_chrome_version": "105",
  "permissions": ["nativeMessaging", "tabs", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Emperor Agent",
    "default_popup": "popup.html"
  },
  "key": ""
}
